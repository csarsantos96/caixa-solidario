# Preferir gerar com: python3 scripts/configure.py
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
POSTGRES_PASSWORD=
# Para desenvolvimento sem Docker, use no backend:
DATABASE_URL=sqlite:///./caixa.db
# Em HTTPS público, alterar para true:
COOKIE_SECURE=false
SESSION_HOURS=12
BIND_ADDRESS=127.0.0.1
APP_PORT=8080
# Opcionais: remetente verificado no Resend. Nunca usar VITE_ para segredos.
RESEND_API_KEY=
RECEIPT_FROM=
